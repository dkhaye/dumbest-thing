Output demo.mp4
Set FontSize 22
Set Width 1280
Set Height 720
Set Theme "IR_Black"

Hide
Type "export PS1='$ '"
Enter
Type "clear"
Enter
Sleep 300ms
Type "php -a"
Enter
Sleep 1000ms
Type '$a[true]  = "boolean";'
Enter
Type '$a[1]     = "integer";'
Enter
Type '$a[1.9]   = "float";'
Enter
Type '$a["1"]   = "string";'
Enter
Sleep 800ms
Show

Type 'print_r($a);'
Enter
Sleep 2500ms
